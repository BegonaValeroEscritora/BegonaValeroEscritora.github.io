---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Compartir from '../../components/Compartir.astro';
import { fechaLarga, hoyISO, iso } from '../../lib/fechas';

export const getStaticPaths = (async () => (await getCollection('agenda')).map((evento) => ({ params: { id: evento.id }, props: { evento } }))) satisfies GetStaticPaths;

const { evento } = Astro.props as { evento: CollectionEntry<'agenda'> };
const d = evento.data;
const { Content } = await render(evento);
const libros = await getEntries(d.libros);
const pasado = iso(d.fecha) < hoyISO();
---
<Base titulo={d.titulo} descripcion={`${fechaLarga(d.fecha)}${d.lugar ? ' · ' + d.lugar : ''}`} imagen={d.imagen}>
  <div class="wrap">
    <article class="article" data-pagefind-body>
      <a class="volver" href="/agenda/" data-pagefind-ignore>← Agenda</a>
      <div class="tagline">
        <time datetime={iso(d.fecha)}>{fechaLarga(d.fecha)}{d.hora && ` · ${d.hora}`}</time>
        {pasado && <span>(evento pasado)</span>}
      </div>
      <h1>{d.titulo}</h1>
      {d.lugar && <p class="sub">{d.lugar}</p>}
      {libros.length > 0 && <div class="pills">{libros.map((l) => <a class="pill" href={`/libros/${l.id}/`}>{l.data.titulo}</a>)}</div>}
      {d.imagen && <div class="hero-img"><Image src={d.imagen} alt="" widths={[600, 1000].filter((w) => w <= d.imagen!.width)} sizes="(max-width: 800px) 100vw, 760px" /></div>}
      <div class="prose" style="margin-top: 24px"><Content /></div>
      {d.enlace && <p><a class="btn ghost" href={d.enlace}>Más información</a></p>}
      <Compartir titulo={d.titulo} />
    </article>
  </div>
</Base>
