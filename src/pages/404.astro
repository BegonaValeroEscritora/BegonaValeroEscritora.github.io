---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada">
  <div class="wrap" style="text-align: center; padding: 96px 16px">
    <div class="eyebrow">Error 404</div>
    <h1 style="font-size: 56px; margin: 12px 0 16px">Página no encontrada</h1>
    <p>Puede que la página se haya movido. Prueba a buscarla o vuelve al inicio.</p>
    <div class="actions" style="justify-content: center; margin-top: 24px">
      <a class="btn primary" href="/">Volver al inicio</a>
      <a class="btn ghost" href="/buscar/">Buscar</a>
    </div>
  </div>
</Base>
