---
import { Image } from 'astro:assets';
import type { Libro } from '../lib/contenido';

interface Props { libro: Libro; ancho?: number; sizes?: string; class?: string; eager?: boolean; }
const { libro, ancho = 240, sizes = `${ancho}px`, class: clase = '', eager = false } = Astro.props;
const src = libro.data.portada;
// Las «otras obras» (p. ej. un cortometraje) no son cubiertas de libro: se muestran sin recortar.
const natural = libro.data.otraObra;
---
{src ? (
  <Image
    src={src}
    alt={`Cubierta de ${libro.data.titulo}`}
    widths={[120, 180, 240, 360, 480, 720].filter((w) => w <= Math.min(src.width, ancho * 2))}
    sizes={sizes}
    quality={72}
    class:list={['cover', { natural }, clase]}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
) : (
  <div class:list={['cover', clase]} />
)}
